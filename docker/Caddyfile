# The platform at /, the API at /api. Reached only through the Cloudflare Tunnel,
# which ends TLS, so this port is never published.
{
	auto_https off
	servers {
		trusted_proxies static private_ranges
		client_ip_headers CF-Connecting-IP
	}
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080 {
			# One address only, Cloudflare's view of the visitor. Anything a
			# client put in X-Forwarded-For is dropped, because the API's rate
			# limits key off this header.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv

		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			Strict-Transport-Security "max-age=15552000; includeSubDomains"
			-Server
		}

		# Built files carry a hash in their name, so they never change.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"

		# Client-side routes fall through to the app.
		try_files {path} /index.html
		file_server
	}
}

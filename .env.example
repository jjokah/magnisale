# Copy to .env. Everything here is optional in development.

# Postgres. The default matches docker-compose.yml. Required in production.
# DATABASE_URL=postgres://magnisale:magnisale@localhost:5433/magnisale

# Where people open the app. Used for links in emails and the Google redirect.
# APP_URL=http://localhost:5173

# Which peers may set X-Forwarded-For. Must name the real reverse proxy, or
# every visitor shares one sign-in rate limit. Comma-separated addresses, CIDRs
# or the presets loopback, linklocal and uniquelocal.
# TRUST_PROXY=loopback

# Google sign-in. Create an OAuth client (Web application) in Google Cloud
# Console, with this redirect URI: <APP_URL>/api/v1/auth/google/callback
# The Google button stays hidden until both are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Password reset email. Without SMTP_URL, development prints the reset link to
# the API log. In production the email is not sent and a warning is logged.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Magnisale <hello@magnisale.com>

# Copy to .env. Nothing here is needed for development.

# --- Development overrides (defaults match docker/compose.dev.yaml) ---
# DATABASE_URL=postgres://magnisale_app:magnisale_app@localhost:5433/magnisale
# OWNER_DATABASE_URL=postgres://magnisale:magnisale@localhost:5433/magnisale
# APP_URL=http://localhost:5173

# --- Production (docker/compose.yaml). Generate each secret with: openssl rand -hex 32 ---
# The address people open, without a scheme. Caddy gets its certificate for it.
# APP_DOMAIN=app.magnisale.com
# APP_URL=https://app.magnisale.com
# Owner of the database, used only by the migrate step.
# POSTGRES_PASSWORD=
# The role the API and workers connect as. It cannot bypass row-level security.
# Hex only, because it is placed in a connection URL.
# APP_DB_PASSWORD=
# BETTER_AUTH_SECRET=

# --- Optional, in any environment ---
# Google sign-in. Create an OAuth client (Web application) in Google Cloud
# Console, with this redirect URI: <APP_URL>/api/auth/callback/google
# The Google button stays hidden until both are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Password reset email. Without SMTP_URL, development prints the reset link to
# the API log. In production the email is not sent and a warning is logged.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Magnisale <hello@magnisale.com>

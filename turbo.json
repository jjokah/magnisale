{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["pnpm-lock.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["NODE_ENV"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL", "TEST_OWNER_DATABASE_URL"]
    },
    "@magnisale/workers#migrate": {
      "cache": false,
      "passThroughEnv": ["OWNER_DATABASE_URL", "APP_DB_PASSWORD"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@magnisale/workers#migrate"],
      "passThroughEnv": ["*"]
    }
  }
}
